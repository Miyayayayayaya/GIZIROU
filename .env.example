OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Flask session signing key. Generate a unique value for each developer.
FLASK_SECRET_KEY=replace-with-a-long-random-value

# Google Auth Platform OAuth client (Web application)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Must exactly match the Authorized redirect URI in Google Cloud Console.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5001/oauth2callback

# Local defaults. On AWS, set FLASK_HOST=0.0.0.0 and PORT=8080.
FLASK_HOST=127.0.0.1
PORT=5001
FLASK_DEBUG=false
